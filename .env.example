# ─────────────────────────────────────────────
#  Humanly — Environment Variables
#  Copy this file to .env and fill in values.
#  Never commit .env to source control.
# ─────────────────────────────────────────────

# ── Required for API and CLI access ───────────
# Use a different long random value before exposing this instance.
# Generate with: openssl rand -hex 32
HUMANLY_API_KEY=
# Set true only for local testing against localhost, a Docker network, or a
# private address. Keep false for any network-reachable deployment.
HUMANLY_ALLOW_PRIVATE_CONNECTORS=false

# ── PostgreSQL ─────────────────────────────────
# docker-compose.yml provides DATABASE_URL internally.
# Set this only when running `npm run dev` against an external database.
DATABASE_URL=postgresql://humanly:humanly@localhost:5432/humanly
POSTGRES_PASSWORD=humanly

# ── App ────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Optional standalone RAG evaluation (no Studio account required).
# Hosted judge calls are billed directly by your model provider.
RAG_JUDGE_API_KEY=
RAG_JUDGE_BASE_URL=https://api.openai.com/v1
RAG_JUDGE_MODEL=gpt-4o-mini
# Only enable for a trusted local judge server; this also permits HTTP.
RAG_JUDGE_ALLOW_PRIVATE=false
# Optional bearer token used by the RAG CLI's live agent connector.
RAG_AGENT_TOKEN=
