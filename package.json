{
  "name": "humanly-oss",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Humanly OSS agent evaluation engine",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/somnath-biswas-github/humanly.git"
  },
  "bugs": {
    "url": "https://github.com/somnath-biswas-github/humanly/issues"
  },
  "homepage": "https://github.com/somnath-biswas-github/humanly#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "rag": "tsx src/rag-cli.ts",
    "workflow": "tsx src/workflow-cli.ts",
    "workflow:fixture": "tsx scripts/workflow-fixture.ts",
    "build": "npm run check && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server.cjs && node scripts/strip-trailing-whitespace.mjs dist/server.cjs",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm test && npm run build && npm run check:links",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.27",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}